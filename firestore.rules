rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net: Default Deny All
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Translucent helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // 3. Stand-Alone Structural Validation Blueprints (Anti-Update-Gap)
    function isValidUserProfile(data) {
      return data.uid is string && data.uid.size() <= 128 && data.uid == request.auth.uid
        && data.xp is int && data.xp >= 0
        && data.coins is int && data.coins >= 0
        && data.streak is int && data.streak >= 0;
    }

    function isValidHabitLog(data) {
      return data.id is string && data.id.size() <= 128
        && data.userId is string && data.userId == request.auth.uid
        && data.habitId is string && data.habitId.size() <= 64
        && (data.value == null || data.value is number)
        && (data.xpReward == null || data.xpReward is int)
        && (data.coinReward == null || data.coinReward is int);
    }

    function isValidPurchaseLog(data) {
      return data.id is string && data.id.size() <= 128
        && data.userId is string && data.userId == request.auth.uid
        && data.itemId is string && data.itemId.size() <= 64
        && data.cost is int && data.cost >= 0;
    }

    // 4. Secure Match Blocks
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUserProfile(incoming());
      allow update: if isOwner(userId) && isValidUserProfile(incoming()) && (
        // Enforce that only specific user-facing progress/stats fields can be updated
        incoming().diff(existing()).affectedKeys().hasOnly([
          'xp', 'coins', 'streak', 'role', 'equippedHoodie', 'equippedVisor', 'equippedShield',
          'ownedItems', 'shiftProgress', 'bossHps', 'sleepHours', 'postureAlignment',
          'activeRestaurantName', 'activeRestaurantAddress', 'activeRestaurantLat', 'activeRestaurantLng',
          'updatedAt'
        ])
      );
      allow delete: if false;

      // Subcollection for Completed Shift Habits
      match /habits/{habitLogId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(habitLogId) && isValidHabitLog(incoming());
        allow update, delete: if false; // Logs are immutable history files
      }

      // Subcollection for Purchases
      match /purchases/{purchaseLogId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(purchaseLogId) && isValidPurchaseLog(incoming());
        allow update, delete: if false; // Purchases are write-once logs
      }
    }
  }
}
